{
  "name": "coachdiary",
  "version": "0.0.0",
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:renderer": "ng build --configuration production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && cross-env NODE_ENV=development electron .\"",
    "electron:prod": "npm run build && electron .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npm run build:renderer && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:dev": "npm run cap:sync && npx cap open android",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.110.3",
    "better-sqlite3": "^12.10.0",
    "dexie": "^4.4.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "fabric": "^7.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "angular-eslint": "22.1.0",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  }
}
