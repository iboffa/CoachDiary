# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Directory where Chroma persists its vector database on disk
CHROMA_PATH=./data/chroma

# Directory where raw knowledge files (PDFs, .txt) are stored for ingestion
DATA_PATH=./data/raw

# Claude model for play generation — Sonnet recommended for spatial JSON accuracy
GENERATION_MODEL=claude-sonnet-4-6

# Claude model for Q&A answers — Haiku is sufficient and much cheaper
QUERY_MODEL=claude-haiku-4-5-20251001

# Claude model for chat conversation turns — Haiku handles the dialogue;
# when it decides to generate a play it hands off to GENERATION_MODEL automatically
CHAT_MODEL=claude-haiku-4-5-20251001
